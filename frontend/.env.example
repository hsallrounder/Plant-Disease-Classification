# Frontend Local Dev Port
VITE_PORT=5173

# Backend Target URL for Vite Dev Server Proxy
VITE_BACKEND_URL=http://localhost:8080

# Client API Base URL
# In local development: use '/api' to leverage Vite's reverse proxy
# In production: set to deployed backend endpoint (e.g. https://your-node-backend.onrender.com/api)
VITE_API_URL=/api
