# Node Backend Server Configuration
PORT=8080
NODE_ENV=production

# Python ML Microservice (Render or Local)
# For local development: http://localhost:5001
# For Render deployment: https://plant-disease-classification-4m29.onrender.com
ML_SERVICE_URL=https://plant-disease-classification-4m29.onrender.com

# Allowed Frontend Client Origin for CORS
# For local development: http://localhost:5173
# For Sandbox Pro / Production: * or your frontend domain (e.g. https://your-frontend-domain.myanatomy.ai)
CLIENT_URL=*

